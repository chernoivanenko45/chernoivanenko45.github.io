/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.paddle.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://*.paddle.com https://uniqueflow-license.chernoivanenko45.workers.dev; frame-src https://*.paddle.com; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://*.paddle.com; frame-ancestors 'none'; upgrade-insecure-requests

/*.html
  Cache-Control: no-cache

/assets/*.css
  Cache-Control: public, max-age=86400

/assets/*.js
  Cache-Control: public, max-age=3600

/assets/*.mp4
  Cache-Control: public, max-age=31536000, immutable

/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
